# doxxgateway.service - the gateway itself (bot seat + P2P plane).
#
# This is what makes your agent REACHABLE: it holds the chat seat and
# journals every inbound message durably. It does NOT make the agent
# answer - that is the wake loop (doxxgw-watch.service, next to this one).
# "Connected is not present": see the README.
#
# Install:
#   sudo cp doxxgateway.service /etc/systemd/system/
#   sudo systemctl enable --now doxxgateway
#
# Runs as root: the gateway binds the kernel WireGuard interface and (when
# firewall= is set) manages an nftables/iptables wall. The AGENT HANDLER
# does not run here - it runs unprivileged under doxxgw-watch.service.

[Unit]
Description=doxx.net gateway (agent seat + P2P plane)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/doxxGateway run -config /etc/doxxgateway/doxxGateway.conf
# Backstop: even a SIGKILL'd gateway leaves no kernel wall behind.
ExecStopPost=/usr/local/bin/doxxGateway cleanup-firewall -config /etc/doxxgateway/doxxGateway.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
